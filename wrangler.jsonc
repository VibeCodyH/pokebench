// Cloudflare Workers config: the leaderboard is static files only, served from site/.
// Workers Builds runs `python3 site/build_runs.py` first so site/runs.json exists at deploy.
{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "pokebench",
  "compatibility_date": "2025-10-01",
  // Custom domains on the same account: deploy creates the DNS records and certificates.
  "routes": [
    { "pattern": "pokebench.tv", "custom_domain": true },
    { "pattern": "www.pokebench.tv", "custom_domain": true }
  ],
  "assets": {
    "directory": "./site",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
